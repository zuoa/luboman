# ===== 录播Man 部署配置 =====
# 复制为 .env 后按需修改：cp .env.example .env
# docker compose 启动时自动读取同目录的 .env（.env 已被 gitignore，不会入库）

# ---- 镜像 tag ----
# 后端镜像：
#   main       完整版，含 Chrome（抖音投稿可用）
#   main-slim  精简版，不含浏览器（小约 400MB；抖音投稿不可用，其余功能一致）
LUBOMAN_APP_TAG=main
# 前端镜像
LUBOMAN_WEBUI_TAG=main

# ---- PostgreSQL ----
# app 服务复用同一组账号密码连接，改密码只需改这里
POSTGRES_USER=luboman
POSTGRES_PASSWORD="luboman@2024#Hangzhou"
POSTGRES_DB=luboman
# 宿主机暴露的 Postgres 端口（容器内固定 5432；仅本机直连数据库时用到）
POSTGRES_PORT=54321

# ---- 服务端口 ----
# 后端 API（webui 容器经内部网络直连，此端口仅本机调试后端时需要）
APP_PORT=5005
# 前端页面访问端口
WEBUI_PORT=5001

# ---- 访问鉴权 ----
# WebUI 访问密码：设置后打开页面需先登录（连续输错会触发限流锁定，防暴力破解）；
# 留空则无需登录（默认，内网自用可保持为空）
WEBUI_PASSWORD=

# ---- 时区 ----
TZ=Asia/Shanghai
